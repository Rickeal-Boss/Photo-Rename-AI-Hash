<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <!-- 前三段必须与 Models/AppSettings.cs 的 AppVersion 一致（CI 有阻断式断言）。
       发版需递增第四段或前段，否则 MSIX 覆盖升级语义失效。 -->
  <Identity Name="PhotoRenameAIHash"
            Publisher="CN=PhotoRenameAIHash"
            Version="3.1.0.0" />
  <Properties>
    <DisplayName>PhotoRenameAIHash</DisplayName>
    <PublisherDisplayName>PhotoRenameAIHash</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
    <!--
      自包含模型：WindowsAppSDKSelfContained=true 已把运行时打进 .msix 内部，
      此处不再声明对外部 Microsoft.WindowsAppSDK 框架的 PackageDependency，
      避免离线安装时因框架未预置导致的 0x80073CF3 依赖校验失败。
    -->
  </Dependencies>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Applications>
    <Application Id="App"
               Executable="PhotoRenameAIHash.exe"
               EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="PhotoRenameAIHash"
          Description="AI hash-based photo rename and dedupe"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:LockScreen BadgeLogo="Assets\BadgeLogo.png" Notification="badge" />
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square310x310Logo="Assets\LargeTile.png"
                         Square71x71Logo="Assets\SmallTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\Splash.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <!-- WinUI 3 桌面应用是 Win32 全信任模型，必须声明 runFullTrust -->
    <rescap:Capability Name="runFullTrust" />
    <!-- AI 视觉识别需要访问智谱 / 通义等 HTTPS 接口 -->
    <rescap:Capability Name="internetClient" />
    <!--
      broadFileSystemAccess 服务的是「通过 Windows.Storage 的路径式 API
      （StorageFolder.GetFolderFromPathAsync 等）访问 FolderPicker 之外的文件」。
      两点必须说清，旧注释（"System.IO 在 MSIX 容器内依赖此能力"）是错的：
      1) full-trust / mediumIL 下 System.IO 根本不受此能力门控，它只作用于 Windows.Storage；
         FolderPicker 选出来的文件夹自带 Broker 令牌，也不需要这个能力。
      2) 本轮备份改走 System.IO.File.Copy 绕开门控，原因不是"缺这个能力"，而是该能力
         默认 Off，且授权后必须重启应用才生效（broker 在进程创建时快照能力授予）——
         就算做授权引导，用户操作完也还是失败。
      声明本身必须保留：它是「设置 → 隐私和安全性 → 文件系统」里本应用条目的存在前提。
      删掉会让已授予授权的用户失去开关，也会让备份失败提示指向一个不存在的开关。
    -->
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>
</Package>
