<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <!-- 前三段必须与 Models/AppSettings.cs 的 AppVersion 一致（CI 有阻断式断言）。
       发版需递增第四段或前段，否则 MSIX 覆盖升级语义失效。 -->
  <Identity Name="PhotoRenameAIHash"
            Publisher="CN=PhotoRenameAIHash"
            Version="3.1.6.0" />
  <Properties>
    <DisplayName>PhotoRenameAIHash</DisplayName>
    <PublisherDisplayName>PhotoRenameAIHash</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
    <!--
      自包含模型：WindowsAppSDKSelfContained=true 已把运行时打进 .msix 内部，
      此处不再声明对外部 Microsoft.WindowsAppSDK 框架的 PackageDependency，
      避免离线安装时因框架未预置导致的 0x80073CF3 依赖校验失败。
    -->
  </Dependencies>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Applications>
    <Application Id="App"
               Executable="PhotoRenameAIHash.exe"
               EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="PhotoRenameAIHash"
          Description="AI hash-based photo rename and dedupe"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:LockScreen BadgeLogo="Assets\BadgeLogo.png" Notification="badge" />
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square310x310Logo="Assets\LargeTile.png"
                         Square71x71Logo="Assets\SmallTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\Splash.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <!-- WinUI 3 桌面应用是 Win32 全信任模型，必须声明 runFullTrust -->
    <rescap:Capability Name="runFullTrust" />
    <!-- 不声明 internetClient：full-trust 桌面应用不在 AppContainer 内，
         AI 视觉识别的 HTTPS 调用不受该能力门控（该能力只对 AppContainer 应用有意义）。 -->
    <!-- 本应用不使用受限文件能力：全部走 System.IO（full trust）与 FolderPicker（自带 Broker 令牌）。
         若将来需要 GetXxxFromPathAsync 这类路径式 WinRT 访问，必须同时恢复 broadFileSystemAccess
         声明并引导用户授权（该能力默认 Off，且授权后需重启应用才生效）。
         CI 有阻断式护栏：Assert manifest capabilities。 -->
  </Capabilities>
</Package>
