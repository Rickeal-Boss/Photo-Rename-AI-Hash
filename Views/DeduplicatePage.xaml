<Page
    x:Class="PhotoRenameAIHash.Views.DeduplicatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoRenameAIHash.Views"
    xmlns:m="using:PhotoRenameAIHash.Models"
    xmlns:vm="using:PhotoRenameAIHash.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Button Content="选择文件夹" Click="PickFolder_Click" />
            <TextBox Width="320" PlaceholderText="文件夹路径"
                     Text="{x:Bind ViewModel.FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="扫描相似图片" Command="{x:Bind ViewModel.ScanCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="aHash 阈值:" VerticalAlignment="Center" />
                <Slider Width="160" Minimum="0" Maximum="20" Value="{x:Bind ViewModel.AHashThreshold, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="dHash 阈值:" VerticalAlignment="Center" />
                <Slider Width="160" Minimum="0" Maximum="20" Value="{x:Bind ViewModel.DHashThreshold, Mode=TwoWay}" />
            </StackPanel>
            <Button Content="删除非保留项" Command="{x:Bind ViewModel.DeleteSelectedCommand}" />
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}" Margin="0,12,0,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:DuplicateGroup">
                    <StackPanel Padding="6" Spacing="4">
                        <TextBlock Text="{x:Bind Id}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{x:Bind Members, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:PhotoFile">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="3" Margin="0,12,0,0"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
