<Page
    x:Class="PhotoRenameAIHash.Views.OrganizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoRenameAIHash.Views"
    xmlns:m="using:PhotoRenameAIHash.Models"
    xmlns:vm="using:PhotoRenameAIHash.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Button Content="选择文件夹" Click="PickFolder_Click" />
            <TextBox Width="320" PlaceholderText="文件夹路径"
                     Text="{x:Bind ViewModel.FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="扫描" Command="{x:Bind ViewModel.ScanCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
            <TextBlock Text="命名规则:" VerticalAlignment="Center" />
            <TextBox Width="260" Text="{x:Bind ViewModel.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="执行重命名" Command="{x:Bind ViewModel.RenameCommand}" />
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Preview, Mode=OneWay}" Margin="0,12,0,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:PhotoFile">
                    <Grid ColumnDefinitions="*,Auto" Padding="4">
                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind NewName}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   Margin="16,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="3" Margin="0,12,0,0"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
