<Page
    x:Class="PhotoRenameAIHash.Views.OrganizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoRenameAIHash.Views"
    xmlns:m="using:PhotoRenameAIHash.Models"
    xmlns:vm="using:PhotoRenameAIHash.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageSpacing}" MaxWidth="{StaticResource PageContentMaxWidth}">
            <TextBlock Text="整理" Style="{StaticResource PageTitleStyle}" />

            <!-- 路径设置 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="路径设置" Style="{StaticResource CardTitleStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="源文件夹" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{x:Bind ViewModel.SourceFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="选择要整理的源文件夹" />
                        <Button Grid.Row="0" Grid.Column="2" Content="浏览" Click="PickSource_Click" Margin="8,0,0,0"
                                ToolTipService.ToolTip="选择要整理的源文件夹" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="输出文件夹" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="整理后输出位置（重命名模式可留空）" />
                        <Button Grid.Row="1" Grid.Column="2" Content="浏览" Click="PickOutput_Click" Margin="8,0,0,0"
                                ToolTipService.ToolTip="选择整理后的输出文件夹" />
                        <!-- ③（第九轮 R9-5）：备份文件夹此前只在「重命名实跑前」弹一次窗、跑完即清空，
                             用户既看不到它、下次还要重选。现在与源/输出文件夹同等待遇：可显示、可持久化。
                             「浏览」走 VM 的 PickBackupFolderCommand（复用页面注入的同一个选择器），
                             故无需页面 code-behind 新增 Click 处理。 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="备份文件夹" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{x:Bind ViewModel.BackupFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="仅「重命名」实际执行时使用；留空则运行时弹窗选择" />
                        <Button Grid.Row="2" Grid.Column="2" Content="浏览"
                                Command="{x:Bind ViewModel.PickBackupFolderCommand}" Margin="8,0,0,0"
                                ToolTipService.ToolTip="选择重命名前保存原件的备份文件夹" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="备份文件夹只在「操作模式 = 重命名」且「实际执行」时使用：重命名前先把原件复制一份进去，供误操作后找回。该位置会随配置一起保存，下次启动沿用；跑完后可在上方输入框看到它。若该文件夹后来被删除或移动，下次运行会提示并重新弹出选择框。「复制 / 移动」模式不产生备份；「按日期归档」也不备份（见下方归档说明）。" />
                </StackPanel>
            </Border>

            <!-- 操作模式（D-2.10：先定「做什么」再定「怎么命名」，故置于识别引擎之前） -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="操作模式" Style="{StaticResource CardTitleStyle}" />
                    <!-- D-2.2：原为单行横向 StackPanel，三组控件最小宽 ≈800px > 卡片可用 ≈780px，
                         必然溢出裁剪（P0-2 只验证了控件语义、未验证布局）。改为两行 Grid：
                         第一行两个下拉并排，第二行 RadioButtons 独占整行。 -->
                    <Grid ColumnSpacing="24" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="模式" VerticalAlignment="Center" />
                            <!-- ①（第十一轮真机验收）：原为「复制 (copy) / 移动 (move) / 重命名 (rename)」，
                                 只写了英文代号、没说清「这个模式做什么」，用户反馈三个功能的解释混乱。
                                 改为「动作 + 对原件的处置」，一眼可懂；MinWidth 相应放宽到 190 防中文裁剪。
                                 只改显示文案，SelectedIndex 绑定与索引语义完全不变（零行为变更）。 -->
                            <ComboBox SelectedIndex="{x:Bind ViewModel.OperationModeIndex, Mode=TwoWay}" MinWidth="190">
                                <ComboBoxItem Content="复制（保留原件）" />
                                <ComboBoxItem Content="移动（移走原件）" />
                                <ComboBoxItem Content="重命名（强制备份）" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="冲突处理" VerticalAlignment="Center" />
                            <ComboBox SelectedIndex="{x:Bind ViewModel.ConflictIndex, Mode=TwoWay}" MinWidth="200">
                                <ComboBoxItem Content="自动重命名(加 _1/_2)" />
                                <ComboBoxItem Content="跳过" />
                                <ComboBoxItem Content="覆盖" />
                            </ComboBox>
                        </StackPanel>

                        <!-- P0-2 修复：原 ToggleSwitch 的 OffContent/OnContent 与 IsOn(DryRun) 绑定语义完全颠倒
                             （DryRun=true 显示「实际执行」），且默认值恰在真实执行状态。改为双选项单选，
                             所见即所选，杜绝标签语义反转。 -->
                        <RadioButtons Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                      SelectedIndex="{x:Bind ViewModel.RunModeIndex, Mode=TwoWay}"
                                      MaxColumns="2">
                            <RadioButton Content="模拟运行（仅预览）" />
                            <RadioButton Content="实际执行（真实改动文件）" />
                        </RadioButtons>
                    </Grid>
                    <!-- ①（第十一轮真机验收）：三模式的「做什么 / 原件会怎样 / 要不要备份」此前散落在
                         备份说明、归档说明、覆盖说明三段长文字里，用户反馈「解释有些混乱」。
                         这里收敛成一张紧凑对照表：一行一个模式、三列固定语义，一眼可对照。
                         语义与内核逐条对齐——复制保留源文件、移动移走源文件、
                         重命名原地改名且实跑前强制先备份（原地覆盖不可恢复，故备份是硬要求）。
                         下方「关于按日期归档」「关于冲突处理=覆盖」两段仍保留：它们说的是
                         「归档 / 覆盖这两个选项各自的特例」，与模式本身的三行速查互补，不重复。 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="三种模式分别做什么" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="12" RowSpacing="2"
                              ColumnDefinitions="Auto,Auto,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="模式" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="原件" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="备份" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="复制 (copy)"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="保留"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="不需要"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="移动 (move)"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="移走"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="不需要"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="重命名 (rename)"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="改名"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="强制备份（防误改不可恢复）"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                    <!-- A-10：模拟运行不调用识别接口（不产生 API 消耗），含 AI 字段的命名在模拟下取不到真实值 -->
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        「模拟运行」不改动任何文件，也不会调用识别接口（不产生 API 消耗）：
                        category / scene / people / action / subtitle / source 等 AI 字段一律填「unknown + 该文件在批次中的序号 + 占位符位置（a/b/c…）」
                        这类占位值（形如 unknown0007a、unknown0007b……同一文件的 6 个 AI 字段各占一位，互不相同），仅用于预览命名结构；
                        「实际执行」会真实复制/移动/重命名；仅当命名规则用到 AI 字段、且识别引擎已启用并配好密钥时才会调用识别接口
                        （识别引擎选「无」时不会调用，此时模板里的 AI 字段取不到真实值，命名规则将回退为默认模板
                        {yyyy}{MM}{dd}_{name}_{n}）。请确认模式后再开始。
                        注意：模拟运行下 AI 字段取不到真实识别结果，预览出的文件名与实际执行的结果会不同，请以实际执行为准。
                    </TextBlock>
                    <!-- ①（第九轮 R9-1）：归档行为此前受「操作模式」影响且完全无说明——模式=重命名时点归档，
                         文件会被移走、状态却写「已重命名」，用户对「模式影响归档」毫无感知。
                         文案必须与内核实现逐条对齐（内核归档语义归一：Rename→Move；Copy 仍保留源文件）：
                         不能写成「归档固定移动、不受模式影响」——那在「复制」模式下与事实不符（P33）。 -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="关于「按日期归档」" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="它按拍摄日期把照片放入输出文件夹下的 yyyy\yyyy-MM-dd 子目录（无 EXIF 时用文件修改时间）。是否保留源文件取决于「操作模式」：「复制」会把照片复制一份到日期目录、源文件保留在原处；「移动」则把源文件移走；「重命名」在归档下没有意义（归档必然改变目录位置），会被按「移动」处理并在日志中说明。另外，归档不做备份——即使模式选「重命名」，归档也不会像「开始整理」那样先备份原件，请先确认输出位置。" />
                    </StackPanel>
                    <!-- ④（第九轮 R9-6）：重命名模式 + 冲突策略「覆盖」会被内核降级为自动加序号，
                         原因此前只藏在结果行的 ToolTip 里。这里前置说明一次，批次结束时再汇总一次。 -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="关于「冲突处理 = 覆盖」" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="模式选「重命名」时覆盖不会生效——原地重命名时目标就在源文件夹里，覆盖会删掉那里的另一个文件，而备份只备份源文件，等于不可恢复地丢数据。此时内核会自动加 _1/_2 序号改名，并在批次结束时汇总告知（结果列表中每一行的提示里也有逐条原因）。" />
                    </StackPanel>
                    <!-- P0-1 配套：EXIF 解析修复后，补上「日期来源」可见开关，让功能状态可感知、可关闭 -->
                    <CheckBox Content="使用照片拍摄时间（EXIF）作为日期来源；无 EXIF 时回退文件修改时间"
                              IsChecked="{x:Bind ViewModel.UseExifDate, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 识别引擎 / 命名规则 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="识别引擎 / 命名规则" Style="{StaticResource CardTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="识别引擎" VerticalAlignment="Center" />
                        <ComboBox SelectedIndex="{x:Bind ViewModel.AiProviderIndex, Mode=TwoWay}" MinWidth="240">
                            <ComboBoxItem Content="无（按日期/序号命名）" />
                            <ComboBoxItem Content="智谱 GLM-4.6V-Flash" />
                            <ComboBoxItem Content="通义千问 Qwen-VL" />
                            <ComboBoxItem Content="自定义 OpenAI 兼容" />
                            <ComboBoxItem Content="NVIDIA Nemotron 30B-A3B" />
                        </ComboBox>
                        <TextBlock Text="API 密钥在「设置」中填写" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="命名规则" />
                        <TextBox Text="{x:Bind ViewModel.NamingTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="可用占位符：{yyyy}{MM}{dd}{HH}{mm}{ss}{date}{n}{name}  |  AI：{category}{scene}{people}{action}{subtitle}{source}"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 执行控制 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="执行控制" Style="{StaticResource CardTitleStyle}" />
                    <!-- AI 字段可用性提示：模板含 AI 占位符而本次拿不到真实识别值时，在点「开始整理」
                         之前就说清后果。四种组合文案不同（由 VM 的 UpdateAiFieldHint 决定）：
                           · 模拟运行 + 引擎≠无 + 缺 Key —— AI 字段落 unknown 占位值，切实跑会整批中止；
                           · 模拟运行 + 引擎=无 —— AI 字段同样落 unknown 占位值（模拟刻意不回退模板），
                             但不会提示「切实跑会中止」（实跑走的是下一条的回退分支）；
                           · 实际执行 + 引擎=无 —— 命名规则被回退为默认模板 {yyyy}{MM}{dd}_{name}_{n}；
                           · 实际执行 + 引擎≠无 + 缺 Key —— 一个文件都不会动，整批立即中止。
                         非阻断：只是说明，不拦操作。IsOpen 走 TwoWay（与页面另两个 InfoBar 一致）：
                         用户可手动关掉，之后条件再次成立时 VM 侧由 false 翻回 true 会重新弹出，不会永久静默。 -->
                    <InfoBar IsOpen="{x:Bind ViewModel.HasAiFieldHint, Mode=TwoWay}"
                             Severity="Warning"
                             Message="{x:Bind ViewModel.AiFieldHint, Mode=OneWay}"
                             IsClosable="True" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <!-- P0-1：改用系统 AccentButtonStyle，亮/暗主题下前景色由系统保证对比度 -->
                        <Button Content="开始整理" Command="{x:Bind ViewModel.StartOrganizeCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="开始处理所选文件夹（模拟运行开启时仅预览）" />
                        <!-- ①（第九轮 R9-1）：归档入口此前没有任何说明。这里给出准确、具体的 ToolTip：
                             归档=按日期放入日期子目录；是否保留源文件取决于「操作模式」（复制保留 / 移动移走）；
                             重命名会被按「移动」处理；且归档一律不备份。 -->
                        <Button Content="按日期归档" Command="{x:Bind ViewModel.ArchiveByDateCommand}"
                                ToolTipService.ToolTip="按拍摄日期把照片放入输出文件夹下的 yyyy\yyyy-MM-dd 子目录（无 EXIF 时用文件修改时间）。模式选「复制」会保留源文件，选「移动」会把源文件移走（选「重命名」会被按「移动」处理）。归档不做备份——即使模式选「重命名」也不会先备份原件，请先确认输出位置。" />
                        <Button Content="取消" Command="{x:Bind ViewModel.CancelCommand}"
                                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <Button Content="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PauseToggleCommand}"
                                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <Button Content="打开输出文件夹" Click="OpenOutput_Click"
                                ToolTipService.ToolTip="在资源管理器中打开输出位置" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 进度 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="进度" Style="{StaticResource CardTitleStyle}" />
                    <!-- P1-1：任务终态（完成/失败/取消）以 InfoBar 高亮提示，可手动关闭 -->
                    <!-- D-2.6：InfoBar 绑专用 StatusBarMessage（终态快照），与下方常驻 StatusText 分工，避免同句重复展示 -->
                    <InfoBar IsOpen="{x:Bind ViewModel.StatusBarOpen, Mode=TwoWay}"
                             Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                             Message="{x:Bind ViewModel.StatusBarMessage, Mode=OneWay}"
                             IsClosable="True"
                             AutomationProperties.LiveSetting="Polite" />
                    <!-- A-11：IsIndeterminate 只在「忙但还没有任何进度值」时为 true。
                         此前恒等于 IsBusy，运行期一直是滚动动画，算好的 Percent 用户根本看不到。 -->
                    <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                 IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.StatusLineVisibility, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                    <!-- AI 速率观测行：把「实际速率 / 服务端响应时长 / 闸门上限」并排显示，
                         说明闸门是「60 秒最多放行几次」的上限保护而非速率目标。
                         未启用 AI 或真实请求不足 2 次时，由 VM 置空文本并自行收起本行。 -->
                    <TextBlock Text="{x:Bind ViewModel.RateText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.RateLineVisibility, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBox x:Name="LogBox" Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                             Style="{StaticResource LogTextBoxStyle}"
                             MinHeight="120" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <!-- 处理结果 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="处理结果" Style="{StaticResource CardTitleStyle}" />
                    <!-- P1-2+3：空态提示与结果列表互斥显示（由 VM 的 Visibility 属性驱动） -->
                    <TextBlock Text="暂无处理记录。开始整理后，这里会显示每个文件的处理结果。"
                               Visibility="{x:Bind ViewModel.NoResultsVisibility, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnDefinitions="*,*,Auto,110" Padding="0,0,0,4"
                          Visibility="{x:Bind ViewModel.ResultsVisibility, Mode=OneWay}">
                        <TextBlock Grid.Column="0" Text="原文件名" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="新文件名" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="状态" FontWeight="SemiBold" Margin="12,0,0,0" />
                        <TextBlock Grid.Column="3" Text="MD5" FontWeight="SemiBold" Margin="12,0,0,0" />
                    </Grid>
                    <ListView ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.ResultsVisibility, Mode=OneWay}"
                              MaxHeight="320" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:RenameLogEntry">
                                <Grid ColumnDefinitions="*,*,Auto,110">
                                    <TextBlock Grid.Column="0" Text="{x:Bind OriginalName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind NewName}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- P1-4：状态列图标化（成功/失败/中性三态重叠，按 Model 计算属性互斥显示），
                                         原状态文本改挂 ToolTip 以不丢失信息；
                                         P1-4 修复：4 处 x:Bind 显式 Mode=OneTime，表明有意绑定不可变对象，
                                         防日后 Status 加 setter 时图标不刷新；
                                         A-12：状态绑定改用 StatusTip（状态+错误详情），让异常原文可见 -->
                                    <Grid Grid.Column="2" Margin="12,0,0,0" ToolTipService.ToolTip="{x:Bind StatusTip, Mode=OneTime}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14"
                                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                  Visibility="{x:Bind IsSuccessVisibility, Mode=OneTime}"
                                                  AutomationProperties.Name="{x:Bind StatusTip, Mode=OneTime}" />
                                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                  Visibility="{x:Bind IsErrorVisibility, Mode=OneTime}"
                                                  AutomationProperties.Name="{x:Bind StatusTip, Mode=OneTime}" />
                                        <FontIcon Glyph="&#xE946;" FontSize="14"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Visibility="{x:Bind IsNeutralVisibility, Mode=OneTime}"
                                                  AutomationProperties.Name="{x:Bind StatusTip, Mode=OneTime}" />
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{x:Bind Md5Short}" Margin="12,0,0,0"
                                               ToolTipService.ToolTip="{x:Bind Md5, Mode=OneTime}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
