<Page
    x:Class="PhotoRenameAIHash.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoRenameAIHash.Views"
    xmlns:sc="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:PhotoRenameAIHash.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="4" MaxWidth="{StaticResource PageContentMaxWidth}">
            <!-- D-3.5：标题行右侧常驻「保存设置」，避免长页需滚到底才能保存 -->
            <Grid Margin="{StaticResource PageTitleMargin}" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="设置" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="保存设置" Command="{x:Bind ViewModel.SaveCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="将当前设置保存到本机" />
            </Grid>

            <!-- 主题 -->
            <sc:SettingsCard Header="主题">
                <sc:SettingsCard.Description>
                    浅色 / 深色 / 跟随系统，切换立即生效并保留。
                </sc:SettingsCard.Description>
                <RadioButtons SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MaxColumns="3">
                    <RadioButton Content="浅色" />
                    <RadioButton Content="深色" />
                    <RadioButton Content="跟随系统" />
                </RadioButtons>
            </sc:SettingsCard>

            <!-- 语言（P2-8：改为下拉，替代自由文本，避免无效值） -->
            <sc:SettingsCard Header="语言">
                <ComboBox SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" Width="220">
                    <ComboBoxItem Content="中文" />
                    <ComboBoxItem Content="English" />
                </ComboBox>
            </sc:SettingsCard>

            <!-- 默认文件夹（D-3.4：该字段由整理页拥有并写入，本页改为只读展示） -->
            <sc:SettingsCard Header="默认文件夹" Description="在「整理」页选择源文件夹后自动记录，此处仅供查看。">
                <TextBox Text="{x:Bind ViewModel.DefaultFolder, Mode=OneWay}"
                         IsReadOnly="True" MinWidth="320" />
            </sc:SettingsCard>

            <!-- 识别引擎 -->
            <sc:SettingsCard Header="识别引擎" Description="AI 视觉识别所用引擎，密钥在下方对应卡片填写。">
                <ComboBox SelectedIndex="{x:Bind ViewModel.AiProviderIndex, Mode=TwoWay}" MinWidth="240">
                    <ComboBoxItem Content="无（按日期/序号命名）" />
                    <ComboBoxItem Content="智谱 GLM-4.6V-Flash" />
                    <ComboBoxItem Content="通义千问 Qwen-VL" />
                    <ComboBoxItem Content="自定义 OpenAI 兼容" />
                    <ComboBoxItem Content="NVIDIA Nemotron 30B-A3B" />
                </ComboBox>
            </sc:SettingsCard>

            <!-- 智谱 API Key -->
            <sc:SettingsCard Header="智谱 API Key">
                <sc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;" AutomationProperties.Name="密钥" />
                </sc:SettingsCard.HeaderIcon>
                <PasswordBox Password="{x:Bind ViewModel.ZhipuApiKey, Mode=TwoWay}" Width="240"
                             ToolTipService.ToolTip="智谱开放平台密钥，经 Windows DPAPI 加密保存于本机" />
            </sc:SettingsCard>

            <!-- 通义千问 API Key -->
            <sc:SettingsCard Header="通义千问 API Key" Description="DashScope 平台密钥。">
                <sc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;" AutomationProperties.Name="密钥" />
                </sc:SettingsCard.HeaderIcon>
                <PasswordBox Password="{x:Bind ViewModel.QwenApiKey, Mode=TwoWay}" Width="240"
                             ToolTipService.ToolTip="DashScope 密钥，经 Windows DPAPI 加密保存于本机" />
            </sc:SettingsCard>

            <!-- NVIDIA API Key -->
            <sc:SettingsCard Header="NVIDIA API Key"
                             Description="Key 形如 nvapi-…，于 build.nvidia.com 生成；本引擎内置自动节流（30 RPM），不影响其它引擎。">
                <sc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;" AutomationProperties.Name="密钥" />
                </sc:SettingsCard.HeaderIcon>
                <PasswordBox Password="{x:Bind ViewModel.NvidiaApiKey, Mode=TwoWay}" Width="240"
                             ToolTipService.ToolTip="NVIDIA API 密钥，经 Windows DPAPI 加密保存于本机" />
            </sc:SettingsCard>

            <!-- 自定义 OpenAI 兼容 API 配置（选择「自定义」引擎时可见） -->
            <sc:SettingsExpander Header="自定义 API（OpenAI 兼容）"
                                 Description="选择「自定义 OpenAI 兼容」引擎时显示下方配置。"
                                 Visibility="{x:Bind ViewModel.CustomProviderVisibility, Mode=OneWay}"
                                 IsExpanded="{x:Bind ViewModel.IsCustomProvider, Mode=OneWay}">
                <sc:SettingsExpander.Items>
                    <sc:SettingsCard Header="端点 URL">
                        <sc:SettingsCard.Description>
                            不要把密钥写在 URL 的 ?key= 里 —— 端点 URL 不做加密存储，请把密钥单独填到下面的「API Key」框。
                        </sc:SettingsCard.Description>
                        <TextBox Text="{x:Bind ViewModel.CustomApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="https://api.openai.com/v1/chat/completions" Width="280" />
                    </sc:SettingsCard>
                    <sc:SettingsCard Header="模型名称">
                        <TextBox Text="{x:Bind ViewModel.CustomApiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="gpt-4o" Width="280" />
                    </sc:SettingsCard>
                    <sc:SettingsCard Header="API Key">
                        <PasswordBox Password="{x:Bind ViewModel.CustomApiKey, Mode=TwoWay}" Width="240"
                                     ToolTipService.ToolTip="自定义端点密钥，经 Windows DPAPI 加密保存于本机" />
                    </sc:SettingsCard>
                    <sc:SettingsCard Header="每分钟请求上限">
                        <sc:SettingsCard.Description>
                            0 = 不限（默认），上限 600。仅当端点有明确 RPM 限制时填写：到达上限会自动排队等待，不会跳过文件（点「取消」除外）。
                        </sc:SettingsCard.Description>
                        <NumberBox Value="{x:Bind ViewModel.CustomApiRpmLimit, Mode=TwoWay}"
                                   Minimum="0" Maximum="600" SmallChange="1" LargeChange="10"
                                   SpinButtonPlacementMode="Inline" Width="240"
                                   ToolTipService.ToolTip="每分钟最多发出的视觉识别请求数；0 表示不主动限速" />
                    </sc:SettingsCard>
                </sc:SettingsExpander.Items>
            </sc:SettingsExpander>

            <!-- D-3.5：「保存设置」按钮已上移至标题行右侧，此处不再重复 -->
            <!-- P1-1：保存结果以 InfoBar 提示（含主题切换提示，替代原状态 TextBlock） -->
            <!-- A-11：IsOpen 必须是 TwoWay（与整理页一致）。此前是 OneWay，用户手动关掉一次后
                 关闭动作只改了控件、回写不到 VM，VM 里 StatusBarOpen 仍为 true，
                 后续赋 true 不再触发变更通知 → 提示永久静默（连「密钥解不开」这条安全提示也不再弹）。 -->
            <InfoBar IsOpen="{x:Bind ViewModel.StatusBarOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                     IsClosable="True"
                     AutomationProperties.LiveSetting="Polite" />

            <TextBlock Text="密钥经 Windows DPAPI 加密保存在本机设置文件中（绑定当前用户，迁移 / 重装系统后不可解密，需重新填写），仅用于本地调用。"
                       TextWrapping="Wrap"
                       MaxWidth="640"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
