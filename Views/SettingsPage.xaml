<Page
    x:Class="PhotoRenameAIHash.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoRenameAIHash.Views"
    xmlns:vm="using:PhotoRenameAIHash.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16" MaxWidth="560">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="外观" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="主题" FontWeight="SemiBold" />
                    <RadioButtons SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <RadioButton Content="浅色" />
                        <RadioButton Content="深色" />
                        <RadioButton Content="跟随系统" />
                    </RadioButtons>
                    <TextBlock Text="语言" FontWeight="SemiBold" />
                    <TextBox Text="{x:Bind ViewModel.Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="默认文件夹" Style="{StaticResource CardTitleStyle}" />
                    <TextBox Text="{x:Bind ViewModel.DefaultFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="AI 视觉识别" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="识别引擎" FontWeight="SemiBold" />
                    <ComboBox SelectedIndex="{x:Bind ViewModel.AiProviderIndex, Mode=TwoWay}" Width="240">
                        <ComboBoxItem Content="无（按日期/序号命名）" />
                        <ComboBoxItem Content="智谱 GLM-4.6V-Flash" />
                        <ComboBoxItem Content="通义千问 Qwen-VL" />
                        <ComboBoxItem Content="自定义 OpenAI 兼容" />
                        <ComboBoxItem Content="NVIDIA Nemotron 30B-A3B" />
                    </ComboBox>
                    <TextBlock Text="智谱 API Key" FontWeight="SemiBold" />
                    <PasswordBox Password="{x:Bind ViewModel.ZhipuApiKey, Mode=TwoWay}" />
                    <TextBlock Text="通义千问 API Key (DashScope)" FontWeight="SemiBold" />
                    <PasswordBox Password="{x:Bind ViewModel.QwenApiKey, Mode=TwoWay}" />
                    <TextBlock Text="NVIDIA API Key (build.nvidia.com)" FontWeight="SemiBold" />
                    <PasswordBox Password="{x:Bind ViewModel.NvidiaApiKey, Mode=TwoWay}" />
                    <TextBlock Text="Key 形如 nvapi-…，于 build.nvidia.com 生成；官方免费档 ~40 RPM 限速已内置适配（本引擎自动节流，不影响其它引擎）。"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- 自定义 OpenAI 兼容 API 配置 -->
                    <Grid Visibility="{x:Bind ViewModel.CustomProviderVisibility, Mode=OneWay}"
                          RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Text="自定义 API" Style="{StaticResource CardTitleStyle}" />
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="端点 URL" FontWeight="SemiBold" />
                            <TextBox Text="{x:Bind ViewModel.CustomApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="https://api.openai.com/v1/chat/completions" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="4">
                            <TextBlock Text="模型名称" FontWeight="SemiBold" />
                            <TextBox Text="{x:Bind ViewModel.CustomApiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="gpt-4o" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Spacing="4">
                            <TextBlock Text="API Key" FontWeight="SemiBold" />
                            <PasswordBox Password="{x:Bind ViewModel.CustomApiKey, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="密钥经 Windows DPAPI 加密保存在本机设置文件中（绑定当前用户，迁移 / 重装系统后不可解密，需重新填写），仅用于本地调用。"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Button Content="保存设置" Command="{x:Bind ViewModel.SaveCommand}" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
