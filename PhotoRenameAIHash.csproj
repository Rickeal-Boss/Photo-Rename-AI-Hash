<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PhotoRenameAIHash</RootNamespace>
    <AssemblyName>PhotoRenameAIHash</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 关键：把含 dpiAwareness(PerMonitorV2) 的 Win32 清单嵌入 .exe。
         否则进程 DPI 感知会落到 Unaware，OS 在 125%+ 缩放下位图拉伸整窗 → 文字发虚。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 单项目 MSIX 打包：EnableMsixTooling + GenerateAppxPackageOnBuild=true 才会产出并签名 .msix -->
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <NoWarn>$(NoWarn);NU1701;CS1591</NoWarn>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      自包含模型（self-contained）：WindowsAppSDKSelfContained=true 把 Windows App SDK
      运行时直接打进应用 .msix 内部，MSIX 不再声明对外部 Microsoft.WindowsAppSDK 框架的
      PackageDependency。安装时只需 Add-AppxPackage -Path 应用.msix，无需任何框架/运行时
      预装——彻底规避"框架版本不匹配/未预置"导致的 0x80073CF3 与启动失败。
      （此路线参考已验证可用的 Screen Translator AI 自包含安装器实现。）
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishProfile>Properties\PublishProfiles\win10-$(Platform).pubxml</PublishProfile>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>PhotoRenameAIHash.pfx</PackageCertificateKeyFile>
    <PackageCertificateThumbprint>9F089DB28AE4CB075CBAC1D1D8073E382271CF3A</PackageCertificateThumbprint>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240428000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="Microsoft.VCRTForwarders.140" Version="1.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
  </ItemGroup>

  <!-- Packaged self-contained: strip the WindowsAppRuntime FrameworkSdkReference so the
       MSIX uses ONLY the bundled self-contained runtime. Without this, a dangling
       framework-package reference remains and the WindowsAppSDK bootstrap asserts
       (0xc000027b) at startup. Required for packaged (MSIX) self-contained per
       Microsoft docs + WindowsAppSDK-Samples (cs2/cs-winui-packaged). -->
  <Target Name="_RemoveFrameworkReferences" BeforeTargets="_ConvertItems;_CalculateInputsForGenerateCurrentProjectAppxManifest">
    <ItemGroup>
      <FrameworkSdkReference Remove="@(FrameworkSdkReference)" Condition="$([System.String]::Copy('%(FrameworkSdkReference.SDKName)').StartsWith('Microsoft.WindowsAppRuntime.'))" />
    </ItemGroup>
  </Target>
</Project>
